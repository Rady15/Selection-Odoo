# Server-side Odoo credentials, used by api/product-image.js (the REST addon
# has no image-write endpoint) and by the maintenance scripts in ./scripts.
#
# This file is committed, so it must never hold a real password. Put the
# credentials in .env.local instead — it is git-ignored and is read
# automatically by Vite (dev) and by scripts/odoo-env.mjs.
